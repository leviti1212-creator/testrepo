# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3000
DATABASE_PATH=./data/adf.db
LOG_LEVEL=info

# --- Reddit (https://www.reddit.com/prefs/apps -> "script" app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Reddit requires a descriptive User-Agent: <platform>:<app id>:<version> (by /u/<you>)
REDDIT_USER_AGENT=node:apple-deal-finder:0.1.0 (by /u/your_username)

# --- eBay (https://developer.ebay.com/my/keys) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# sandbox | production
EBAY_ENV=production

# --- Sources: comma-separated adapter ids to enable ---
ENABLED_SOURCES=reddit,ebay
# Default poll interval in minutes
POLL_INTERVAL_MINUTES=5
